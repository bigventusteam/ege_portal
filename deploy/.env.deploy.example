# EGE Lisans Portalı — canlı dağıtım sırları (docker-compose.yml bunu okur).
# Bu dosyayı `ege_portal/deploy/.env` olarak kopyalayıp doldurun — GERÇEK
# değerleriyle ASLA commit edilmez (.gitignore'da).

# Alan adı — otomatik HTTPS (Caddy) ve ALLOWED_ORIGINS bunu kullanır.
# Gerçek DNS kaydı AYRICA, bu dosyanın dışında yapılmalı (A kaydı bu
# sunucunun IP'sine işaret etmeli, aksi halde Let's Encrypt doğrulaması
# başarısız olur).
PORTAL_DOMAIN=portal.bigventus.com

# PostgreSQL parolası — rastgele üretin (ör. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Oturum token imzalama anahtarı — rastgele, uzun (ör. `openssl rand -hex 32`).
# "dev-only"/"change-me" gibi bilinen değerler app/startup_checks.py
# tarafından REDDEDİLİR.
SECRET_KEY=

# bvpay sanal POS.
BVPAY_URL=
BVPAY_API_KEY=

# Ed25519 LİSANS İMZALAMA özel anahtarının HOST üzerindeki dosya yolu
# (konteynerin İÇİNE salt-okunur bağlanır — bkz. docker-compose.yml).
EGE_LISANS_PRIVATE_KEY_PATH=/root/sirlar/ege_lisans_ozel_anahtar.pem

# Lisans süresi dolunca "grace" (uyarı) modunda kaç gün daha çalışılacağı.
LICENSE_GRACE_DAYS=14
