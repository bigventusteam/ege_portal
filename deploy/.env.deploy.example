# EGE Lisans Portalı — canlı dağıtım sırları (docker-compose.yml bunu okur).
# Bu dosyayı `ege_portal/deploy/.env` olarak kopyalayıp doldurun — GERÇEK
# değerleriyle ASLA commit edilmez (.gitignore'da).

# Alan adı — otomatik HTTPS (Caddy) ve ALLOWED_ORIGINS bunu kullanır.
# Gerçek DNS kaydı AYRICA, bu dosyanın dışında yapılmalı (A kaydı bu
# sunucunun IP'sine işaret etmeli, aksi halde Let's Encrypt doğrulaması
# başarısız olur).
PORTAL_DOMAIN=portal.bigventus.com

# PostgreSQL parolası — rastgele üretin (ör. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Oturum token imzalama anahtarı — rastgele, uzun (ör. `openssl rand -hex 32`).
# "dev-only"/"change-me" gibi bilinen değerler app/startup_checks.py
# tarafından REDDEDİLİR.
SECRET_KEY=

# bvpay sanal POS.
BVPAY_URL=
BVPAY_API_KEY=

# ── Lisans imza anahtarı (runbook: deploy/OKUBENI.md "Üretim anahtarı") ──
# Parolayla ŞİFRELİ Ed25519 özel anahtarın (scripts/uretim_anahtari_olustur.py)
# ve parolasını içeren dosyanın HOST yolları. İkisi de konteynere Docker
# secret olarak salt-okunur bağlanır; sahibi 1000:1000, izni 0400 olmalı.
# Parolanın KENDİSİNİ buraya ya da herhangi bir env'e YAZMAYIN.
EGE_LISANS_PRIVATE_KEY_PATH=/srv/ege_sirlar/ege_lisans_ozel_anahtar.pem
EGE_LISANS_PASSWORD_FILE_PATH=/srv/ege_sirlar/ege_lisans_anahtar_parola
# birincil | yedek — yedeğe geçişte yukarıdaki iki yol ile BİRLİKTE değişir.
EGE_LISANS_ANAHTAR_KIMLIGI=birincil
# Araç çıktısındaki parmak izi (sha256:...) — eşleşmezse portal başlamaz.
EGE_LISANS_ACIK_ANAHTAR_PARMAK_IZI=

# Lisans süresi dolunca "grace" (uyarı) modunda kaç gün daha çalışılacağı.
LICENSE_GRACE_DAYS=14
