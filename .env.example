# EGE Lisans Portalı — ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun.

# "production" iken app/startup_checks.py EK zorunluluklar uygular
# (SECRET_KEY boş/varsayılan OLAMAZ, COOKIE_SECURE=true OLMALI) — eksikse
# süreç HİÇ BAŞLAMAZ (fail-closed). Geliştirmede boş bırakın/"development"
# yazın.
ENVIRONMENT=development

# ── Veritabanı ────────────────────────────────────────────────────────────
# Geliştirmede varsayılan: proje altında bir SQLite dosyası. Üretimde
# PostgreSQL kullanın: postgresql://kullanici:parola@host:5432/veritabani_adi
DATABASE_URL=sqlite:///./ege_portal.db

# ── Oturum / imzalı token ─────────────────────────────────────────────────
# Login token'larını (oturum çerezi + bearer) imzalamak için kullanılır.
# Tanımlı değilse login/register uçları hata verip durur. Üretimde rastgele,
# uzun bir değer üretin (ör. `openssl rand -hex 32`) — "dev-only"/"change-me"
# gibi bilinen değerler startup_checks tarafından REDDEDİLİR.
SECRET_KEY=

# Oturum çerezine `Secure` bayrağı eklensin mi? Yalnız TLS sonlandıran bir
# ters proxy arkasında "true" yapın — aksi halde tarayıcı çerezi hiç göndermez.
# production'da ZORUNLU true (bkz. ENVIRONMENT).
COOKIE_SECURE=false

# ── CORS / CSRF ────────────────────────────────────────────────────────────
# Hem CORS'ta hem app/middleware.py'deki Origin doğrulama (CSRF savunması)
# middleware'inde kullanılır — virgülle ayrılmış TAM origin'ler (şema+host
# [+port], yol YOK). Canlıda: https://portal.bigventus.com
ALLOWED_ORIGINS=http://localhost:5173

# ── bvpay ──────────────────────────────────────────────────────────────────
# Sanal POS servisi. Mock modda çalışırken de bir URL/anahtar gerekir
# (gerçek istekler yalnızca üretimde atılır; testler sahte istemci kullanır).
BVPAY_URL=http://localhost:9000
BVPAY_API_KEY=

# ── Lisans imzalama ────────────────────────────────────────────────────────
# Ed25519 ÖZEL anahtarının dosya YOLU (içeriği değil). Tanımlı değilse
# imzalama açık bir hatayla durur, sessizce imzasız lisans üretilmez.
EGE_LISANS_OZEL_ANAHTAR=

# Lisans süresi dolunca bu kadar gün "grace" (uyarı) modunda çalışmaya
# devam edilir, sonra lite/kilitli moda düşülür.
LICENSE_GRACE_DAYS=14

# ── İndirme merkezi ────────────────────────────────────────────────────────
# Sürüm dosyalarının saklandığı kök dizin (bkz. scripts/surum_yayinla.py).
# Konteynerde kalıcı bir volume'e bağlanmalı (bkz. deploy/docker-compose.yml).
PORTAL_RELEASE_DIR=./release_storage
